<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper  
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"  
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.embed.mapper.ReviewMapper">

  <!-- 리뷰 + 답변 매핑 -->
  <resultMap id="ReviewWithReplies" type="org.embed.dto.ReviewDTO">
    <id property="id" column="review_id"/>
    <result property="userId" column="user_id"/>
    <result property="userName" column="user_name"/>
    <result property="userPassword" column="user_password"/>
    <result property="content" column="content"/>
    <result property="createdAt" column="created_at"/>
    <collection property="replies" ofType="org.embed.dto.ReplyDTO">
      <id property="id" column="reply_id"/>
      <result property="reviewId" column="reply_review_id"/>
      <result property="userId" column="reply_user_id"/>
      <result property="userName" column="reply_user_name"/>
      <result property="userPassword" column="reply_user_password"/>
      <result property="content" column="reply_content"/>
      <result property="createdAt" column="reply_created_at"/>
    </collection>
  </resultMap>

  <!-- 모든 리뷰 + 답변 조회 -->
  <select id="selectAll" resultMap="ReviewWithReplies">
    SELECT
      r.id AS review_id,
      r.user_id,
      r.user_name,
      r.user_password,
      r.content,
      r.created_at,
      p.id AS reply_id,
      p.review_id AS reply_review_id,
      p.user_id AS reply_user_id,
      p.user_name AS reply_user_name,
      p.user_password AS reply_user_password,
      p.content AS reply_content,
      p.created_at AS reply_created_at
    FROM review_table r
    LEFT JOIN reply_table p ON r.id = p.review_id
    ORDER BY r.id, p.id
  </select>

  <!-- 리뷰 삽입 -->
  <insert id="insertReview" parameterType="org.embed.dto.ReviewDTO" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO review_table (user_id, user_name, user_password, content, created_at)
    VALUES (#{userId}, #{userName}, #{userPassword}, #{content}, #{createdAt})
  </insert>

  <!-- 답변 삽입 -->
  <insert id="insertReply" parameterType="org.embed.dto.ReplyDTO" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO reply_table (review_id, user_id, user_name, user_password, content, created_at)
    VALUES (#{reviewId}, #{userId}, #{userName}, #{userPassword}, #{content}, #{createdAt})
  </insert>

  <!-- 리뷰 삭제 -->
  <delete id="deleteReview" parameterType="long">
    DELETE FROM review_table WHERE id = #{id}
  </delete>

  <!-- 답변 삭제 -->
  <delete id="deleteReply" parameterType="long">
    DELETE FROM reply_table WHERE id = #{id}
  </delete>

</mapper>
